// THE IDEA
// immutable by default
// not hiding pointers
// explicit declarations & definitions
// NO `null` or `undefined`, only Option<T> (options have None)
// imported code is Unsafe by default and should be unwraped
// as for Option

// VARIABLES
// All variables are immutable by default
// Type is required when declaring plain variable


// Variables declares that way won't be `undefiend`
// default value based on type will be assigned
// variables should be assigned with value at declaration
// declaring variable without defining means 
// by design that var should be declared as mutable
// and special syntax should be used

mut id number // 0
mut name string // ""
mut isAdult boolean // false
mut bigNum bigint // 0n

@id // Symbol

// No `null` or `undefined`
// abui will be compiled to javascript with javascript
// importing external js libs is possible, however, code
// from those will be marked as `unsafe` type which is basically
// represents `null` or `undefined`

// Types could be inferred during assign

anotherId := 1001
anotherName := "Aleh Belski"
anotherIsAdult := true
anotherbigNum := 100000000000000000000000000001n


// Reference types from js could also be stored in variables
// Declaration values will be also defaulted to empty sets of data
// EXCEPT!!! Arrow functions, which should assigned with value
// We're not hiding how language works, *Ptr should be there!

// However when declaring ref type variables definition can be skipped
// because those are immutable by default and initialized with defaulted values
// of it`s empty type
ids []number // *[]
idMap Map<K, V> // *Map()
idSet Set<K, V> // *Set()

someFn Function // WRONG!!!
someFn := fn () {} // Right way

// same as for regular var, refs could be passed right away.

// FUNCTIONS

fn sum(a number, b number) number {
	return a + b
}

// Reference types should be shown explicitely
fn sumArr(arr *[]number) number {
	return arr.reduce(0) { acc, value do
		acc += value
	}
}

// Closures and mutable arguments
fn retFn(mut num number) *(num2 number) number {
	num *= 2 // num argument could be modified
	return fn (num2 number) number {
		num + num2
	}
}

// generator
fn* range(start number, end number) {
    mut i = start
    for i in nums {
        yield i
    }
}

// generics
fn<T> identity(val T) T {
    return val
}

// async functions
async fn fetchUser(id number) Promise<User> {
    Promise.resolve(id)
}


// Enums
enum RequestState {
    Idle
    Loading
    Success(data User)
    Failure(message string)
}

// Interfaces
// INTERFACES NOT LIKE IN TYPESCRIPT, PLS
// interfaces are contracts which means following:
// in order to represent type you should follow some 
// contract(protocol) or behavior
// Only methods could be used

interface Stringified {
	fn toString() string
}

// Objects
// Not classes, not constructor funciton, non of theese
// Just object, however, will be compiled to classes
// And since js supports #private we gonna do it as well
// and NO Static methods!!! no way, functions already first class
// citizens in JS and we have modules, don't wrap functions
// in classes

object Address {
	zip     number
	city    string
	state   string
	street  string
	country string
}

// In this example Address could be represented as Stringified
prototype Address {
	fn toString() {
		return "{street}, {zip} {city}, {state}, {country}"
	}
}

// Anything that implemets toString() method could be passed to this fn
// interfaces already a pointers
fn printStr(address Stringified) {
	console.log(address.ToString())
}

// creating and destructuring objects
addr := Address{zip: 2020} // we didn't mentioned other fields,
                           // which will be just empty strings due to zero init
// unpack is used to destruct object or array
// if unpacked value should be mutable mark it explicitely
unpack {street, mut city} := addr 


// MATCH
// deserialization
// All objects will have .fromJSON method return Result
match try Address.fromJSON('{"state": "Nevada"}') {
    Ok(addr) -> console.log(addr.state)
    Err(e)   -> console.log("Failed to parse:", e)
}

// match on enum
fn handleState(state RequestState) {
    match state {
        .Idle             -> console.log('idle')
        .Loading          -> console.log('loading')
        .Success(data)    -> console.log(data)
        .Failure(message) -> console.log(message)
    }
}

// option
// Some is the option to Throw Option :D
// meaning it should be unwrapped with Ok, None
fn findUnser(id number) Option<Address> {
    return Some(Address{zip: 2020})
}

match try findUnser(1) {
    Some(addr) -> console.log(addr.zip)
    None       -> console.log("Address not found")
}


